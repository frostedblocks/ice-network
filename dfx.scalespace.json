{
  "version": 1,
  "canisters": {
    "ice": {
      "type": "motoko",
      "main": "backend/main.mo",
      "declarations": {
        "output": "frontend/src/declarations/ice",
        "bindings": ["js", "ts", "did"]
      }
    },
    "messaging": {
      "type": "motoko",
      "main": "messaging/main.mo",
      "declarations": {
        "output": "frontend/src/declarations/messaging",
        "bindings": ["js", "ts", "did"]
      }
    },
    "assets": {
      "type": "assets",
      "source": ["frontend/dist"],
      "dependencies": ["ice", "messaging"]
    },
    "internet_identity": {
      "type": "custom",
      "candid": "internet_identity/internet_identity.did",
      "wasm": "internet_identity/internet_identity_dev.wasm.gz",
      "remote": {
        "id": {
          "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        }
      },
      "frontend": {}
    }
  },
  "defaults": {
    "build": {
      "packtool": ""
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "providers": ["https://icp0.io"],
      "type": "persistent"
    }
  },
  "output_env_file": "frontend/.env.local"
}
