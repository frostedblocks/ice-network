# Stripe platform keys (server only — never NEXT_PUBLIC_ for secrets)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform publishable key (pk_) — returned to owner after OAuth for setStripePublic
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Connect OAuth client id from Stripe Dashboard → Connect → Settings (ca_...)
STRIPE_CONNECT_CLIENT_ID=ca_...

# HMAC secret for OAuth state + completion cookies (long random string)
CONNECT_OAUTH_STATE_SECRET=replace-with-long-random-secret

# Backend IC identity for recordReceipt (trustedRecorder). Prefer seed for Vercel env.
# 32-byte hex (64 chars) OR base64 of 32 bytes:
CONNECT_BACKEND_IC_SEED=
# OR PKCS#8 Ed25519 PEM (multiline; use \n in Vercel or a single-line env):
# CONNECT_BACKEND_IC_IDENTITY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Browser app origin (frostedblocks.com) — CORS + OAuth return redirects
NEXT_PUBLIC_APP_ORIGIN=https://frostedblocks.com

# This backend's public origin (Vercel URL) — OAuth redirect_uri base
CONNECT_PUBLIC_ORIGIN=https://your-connect-backend.vercel.app

# Optional
# IC_HOST=https://icp-api.io
# CONNECT_PLATFORM_FEE_BPS=0
