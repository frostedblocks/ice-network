# ICE assets (Vite) — copy to .env.local for local builds, or export in CI/deploy.
# Never put Stripe secrets or CONNECT_BACKEND_IC_SEED here (server-only).

# Required for Stripe Connect (owner bind) and public Buy checkout.
# Public HTTPS origin of the connect-backend deploy — no trailing slash.
# Without this, SiteStore / PublicSite show a setup message and Connect/Buy are disabled.
# Example: https://ice-connect-xxxxx.vercel.app
VITE_CONNECT_API_ORIGIN=

# Optional canister ID overrides (else vite.config.js reads ../canister_ids.json / .dfx)
# CANISTER_ID_ICE=
# CANISTER_ID_INTERNET_IDENTITY=
# DFX_NETWORK=ic
