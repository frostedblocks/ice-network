type WasmPushResult = 
 record {
   failed: vec record {
                 principal;
                 text;
               };
   skipped: nat;
   upgraded: nat;
 };
type TransformArgs = 
 record {
   context: blob;
   response: HttpResponsePayload;
 };
type TransferLogEntry = 
 record {
   at: int;
   fromOwner: principal;
   kind: text;
   site: principal;
   toOwner: principal;
 };
type ResetLogEntry = 
 record {
   at: int;
   kind: text;
   site: principal;
   siteOwner: principal;
   triggeredBy: principal;
 };
type RecoveryRequest = 
 record {
   at: int;
   note: text;
   registeredOwner: opt principal;
   requester: principal;
   site: principal;
 };
type PendingMint = 
 record {
   createdAt: int;
   intendedOwner: principal;
   lastError: text;
   site: principal;
   stage: text;
   updatedAt: int;
 };
type OpResult = 
 variant {
   err: text;
   ok: text;
 };
type HttpResponsePayload = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type HostingDomainRow = 
 record {
   dnsConfigured: bool;
   domain: text;
   publicUrl: text;
   site: principal;
 };
type Factory = 
 service {
   /// Owner: drop pending tracking (does not delete the canister — may still burn cycles).
   adminAbandonPendingMint: (site: principal) -> (text);
   /// Master: after verifying the requester’s identity offline, approve and issue code.
   /// Code is returned once to master AND queued for the requester via revealPendingRecoveryCode.
   adminApproveRecoveryRequest: (site: principal, requester: principal,
    identityVerified: bool) -> (OpResult);
   /// Owner: push all known factory sites into the Registry (one-time after wiring).
   adminBackfillRegistry: () -> (text);
   adminClearConnectBackend: () -> (text);
   /// Ops: convert N e8s ICP on factory into factory cycles (default 2.7 ICP).
   adminConvertIcpToCycles: (amountE8s: nat) -> (text);
   adminCreateUserSite: (user: principal) -> (CreateUserSiteResult);
   /// Master/ops: force-reset any registered (minted) site even if user offline / site broken.
   /// No user rate limit. Factory owner only. Always logged.
   adminForceResetSite: (site: principal) -> (OpResult);
   /// Master: issue recovery code for a site (queued for site owner reveal).
   /// Prefer adminApproveRecoveryRequest after the user proves an II session.
   adminGenerateSiteRecoveryCode: (site: principal) -> (OpResult);
   adminLinkUserCanister: (user: principal, site: principal) -> (text);
   /// Master: create/link a site for a principal who already joined ICE but has no canister.
   /// Never charges Join fee. Idempotent if they already have a linked site.
   adminProvisionSite: (user: principal) -> (CreateUserSiteResult);
   /// Factory owner: push latest user_site WASM to linked sites where factory is controller.
   /// Skips detached, non-controlled, and critically low-cycle sites. Logs failures; never force.
   adminPushLatestWasmToAll: (limit: nat) -> (WasmPushResult);
   /// Owner: ensure every factory-known site is in Registry; report missing.
   adminReconcileRegistry: () -> (text);
   adminRecreateUserSite: (user: principal) -> (CreateUserSiteResult);
   adminRejectRecoveryRequest: (site: principal, requester: principal) ->
    (OpResult);
   /// Owner: finish a half-created site from its last recorded stage.
   adminResumePendingMint: (site: principal) -> (CreateUserSiteResult);
   /// Best-effort seed on an existing site.
   adminSeedTrustedRecorderOnSite: (site: principal) -> (text);
   /// Public docs for UI: who is on the standard controller set.
   adminSetConnectBackend: (p: principal) -> (text);
   /// Owner/ops: set explicit controller list. Factory principal is always forced into the list
   /// so reset/upgrade recovery never permanently loses Factory control.
   adminSetControllers: (site: principal, controllers: vec principal) ->
    (text);
   adminSetDomainConnectFee: (feeE8s: nat) -> (text);
   adminSetFees: (detachFeeE8s: nat, relinkFeeE8s: nat, topupIcpE8sPerT:
    nat) -> (text);
   adminSetMintFee: (feeE8s: nat, cyclesShareE8s: nat) -> (text);
   adminSetPrincipalMigration: (open: bool) -> (text);
   /// Owner: wire the central mint Registry (must authorize this Factory on the Registry first).
   adminSetRegistry: (reg: principal) -> (text);
   adminSetTransferFee: (feeE8s: nat) -> (text);
   /// Factory owner: re-sync site canister owner from factory mapping (fixes photo upload auth).
   adminSyncSiteOwner: (site: principal) -> (OpResult);
   adminUnlinkUserCanister: (user: principal) -> (text);
   /// Factory owner: upgrade any known site to latest user_site WASM (preserves stable data).
   adminUpgradeUserSite: (site: principal) -> (OpResult);
   appendUserSiteWasm: (chunk: blob) -> (text);
   appendUserSiteWasmHex: (hex: text) -> (text);
   /// Apply standard controllers (owner + factory) to one linked site. Not a mass migration.
   applyStandardControllers: (user: principal) -> (text);
   /// Alias of applyStandardControllers (owner + factory).
   applyStandardControllersWithOps: (user: principal) -> (text);
   cancelSiteTransferOffer: () -> (OpResult);
   cancelSubscription: (user: principal) -> (text);
   /// Auto top-up when site cycles < ~1T: 0.5 ICP from caller (ICRC-2) → CMC → userSite cycles.
   /// Site canisters may call with userSite = self; payer is resolved to the site owner.
   /// Does not trap. Not used on detach.
   checkAndTopUp: (userSite: principal) -> ();
   /// Verify DNS via on-chain ICP validate and mark ready (enables HTTPS hosting / detach).
   checkDns: () -> (OpResult);
   claimOwner: () -> (text);
   /// Existing accounts only: while migration is open, claim a factory-registered site by id.
   /// Remaps ownership + controllers to the caller's current II. Each site once.
   claimSiteByCanisterId: (site: principal) -> (OpResult);
   /// Recipient: claim a site with the one-time offer code (full handoff).
   claimSiteTransfer: (code: text) -> (OpResult);
   /// Log in with any II, paste recovery code → site remaps to this II (full handoff).
   claimSiteWithRecoveryCode: (code: text) -> (OpResult);
   clearUserSiteWasm: () -> (text);
   confirmSiteDns: () -> (OpResult);
   /// One-step connect: charge 1 ICP (ICRC-2) if needed, then set domain + https://domain (set_domain).
   /// DNS records are shown client-side; call checkDns after DNS is live to enable HTTPS/detach.
   connectDomain: (domain: text) -> (OpResult);
   /// Owner: create a one-time transfer offer. Returns plaintext code once.
   createSiteTransferOffer: () -> (OpResult);
   /// Create transfer offer for a specific owned site (multi-site safe).
   createSiteTransferOfferFor: (site: principal) -> (OpResult);
   /// Caller must already be registered on ICE (free Join).
   /// Fresh mint charges MINT_FEE_E8S (10 ICP) unless waived; retries/resume do not re-charge.
   /// Idempotent: returns existing linked site if present.
   createUserSite: () -> (CreateUserSiteResult);
   /// Detach: unlink site from the main ICE network index. User canister stays intact
   /// (controllers, data, domain). Mint record remains in the central Registry for reattach.
   /// Requires domain + public URL + DNS confirmed + healthy site cycles. Fee via II approve + chargeIcp.
   detach: () -> (OpResult);
   /// Same as createUserSite — preferred name for post-Join retries (no second mint fee if pending/linked).
   ensureUserSite: () -> (CreateUserSiteResult);
   fetchNnsDepositBalance: (user: principal) -> (nat);
   finalizeUserSiteWasm: () -> (text);
   getAutoTopUpStatus: (user: principal) -> (opt AutoTopUpPref) query;
   getConnectBackend: () -> (opt principal) query;
   getControllerPolicy: () ->
    (record {
       dfxInDefault: bool;
       factoryMustRemain: bool;
       note: text;
       roles: vec record {
                    text;
                    text;
                  };
     }) query;
   getFactoryCycles: () -> (nat) query;
   getFactoryIcpBalanceE8s: () -> (nat);
   getFees: () ->
    (record {
       detachFeeE8s: nat;
       domainConnectFeeE8s: nat;
       mintCyclesShareE8s: nat;
       mintFeeE8s: nat;
       mintNetworkOpsE8s: nat;
       relinkFeeE8s: nat;
       topupIcpE8sPerT: nat;
       totalIcpReceivedE8s: nat;
       transferFeeE8s: nat;
     }) query;
   /// Assets canister that serves the public ICE app / personal site viewer.
   getHostingAssetsCanisterId: () -> (text) query;
   /// Text file body for assets `/.well-known/ic-domains` (one host per line) + static ICE domains.
   getIcDomainsFileBody: () -> (text) query;
   /// Last known site for user (even if detached).
   getLastSite: (user: principal) -> (opt principal) query;
   getMyCycleAlerts: (limit: nat) -> (vec CycleAlert) query;
   getMyRecoveryRequests: () -> (vec RecoveryRequest) query;
   getMyTransferOfferStatus: () ->
    (record {
       claimed: bool;
       expiresAt: int;
       hasOffer: bool;
       site: opt principal;
       transferFeeE8s: nat;
     }) query;
   /// Ops health: factory mint capacity + optional registry balance (if configured).
   getNetworkCyclesHealth: () ->
    (record {
       factoryCanMint: bool;
       factoryCycles: nat;
       factoryMinMint: nat;
       message: text;
       registryCycles: opt nat;
       registryLow: bool;
     });
   getNnsDepositInfo: (user: principal) ->
    (record {
       note: text;
       owner: principal;
       subaccountHex: text;
     }) query;
   getOwner: () -> (principal) query;
   getOwnerCycleAlerts: (limit: nat) -> (vec CycleAlert) query;
   getPrincipalMigrationStatus: () ->
    (record {
       claimedCount: nat;
       open: bool;
     }) query;
   /// Whether the factory can mint a new user_site right now (cycles + WASM).
   /// UI should block paid Join when canMint is false so users do not pay without a site.
   getProvisionCapacity: () ->
    (record {
       canMint: bool;
       factoryCycles: nat;
       message: text;
       minRequired: nat;
       wasmReady: bool;
     }) query;
   getRegistryId: () -> (principal) query;
   getResetLog: (limit: nat) -> (vec ResetLogEntry) query;
   /// Public: resolve hostname → personal site canister (for custom-domain hosting on assets SPA).
   getSiteByDomain: (domain: text) -> (opt principal) query;
   getSiteDomainConnection: (site: principal) -> (opt DomainRecord) query;
   getSiteOwner: (site: principal) -> (opt principal) query;
   getTransferLog: (limit: nat) -> (vec TransferLogEntry) query;
   getUserCanister: (user: principal) -> (opt principal) query;
   /// UI: can the caller request a user factory-reset now?
   getUserResetStatus: () ->
    (record {
       allowed: bool;
       attached: bool;
       cooldownHours: nat;
       cooldownRemainingNs: int;
       isLinkedOwner: bool;
       message: text;
     }) query;
   /// Admin/ops: sites owned by a given user.
   getUserSites: (user: principal) -> (vec principal) query;
   getWasmMagicHex: () -> (text) query;
   getWasmSize: () -> (nat) query;
   /// Legacy alias
   handoverControllers: (user: principal) -> (text);
   hasSiteRecoveryCode: () -> (bool) query;
   health: () -> (text) query;
   /// Public helper: can this canister reattach? (Registry / local mint record)
   isEligibleForReattach: (site: principal) -> (bool);
   /// Public: is the Factory still a controller of this site? (ops / UI health)
   isFactoryControllerOf: (site: principal) -> (bool);
   isLinked: (user: principal) -> (bool) query;
   isSiteReadyToDetach: (site: principal) -> (bool) query;
   listActiveCanisters: () -> (vec record {
                                     principal;
                                     principal;
                                   }) query;
   /// Public list of registered personal domains (for ic-domains sync / ops).
   listHostingDomains: () -> (vec HostingDomainRow) query;
   /// All sites owned by caller (multi-site). Derived from siteOwners map.
   listMySites: () -> (vec principal) query;
   listPendingMints: () -> (vec PendingMint) query;
   listPendingRecoveryRequests: () -> (vec RecoveryRequest) query;
   /// All known sites (user, site) for master emergency panel — linked and last-known.
   listRegisteredSites: () -> (vec record {
                                     principal;
                                     principal;
                                     bool;
                                   }) query;
   /// Soft probe for UI/ops (does not mutate state).
   probeDomainValidate: (domain: text) -> (OpResult);
   /// Quote ICP e8s required to top up `cyclesAmount` cycles.
   quoteTopUpIcpE8s: (cyclesAmount: nat) -> (nat) query;
   /// Owner: regenerate recovery code for preferred site (old code dies).
   regenerateSiteRecoveryCode: () -> (OpResult);
   regenerateSiteRecoveryCodeFor: (site: principal) -> (OpResult);
   /// Reattach (relink): rejoin the ICE factory network.
   /// Registry must confirm the canister was previously minted by this Factory — rejects all others.
   /// Optional siteId: if null, uses lastSite for caller.
   relink: (siteId: opt principal) -> (OpResult);
   /// Linked site owner only: full factory reset. Rate limited to once per 24h per site.
   /// Not available when detached. NNS/dfx controllers cannot use this path (owner II only).
   requestFactoryReset: () -> (OpResult);
   /// User: prove an II session and request master help for a site recovery code.
   requestSiteRecovery: (site: principal, note: text) -> (OpResult);
   /// One-shot: return mint/regen code for caller, then clear pending reveal.
   revealPendingRecoveryCode: () -> (OpResult);
   /// Scan linked sites (limit) and attempt auto top-up where enabled. Skips detached.
   scanAutoTopUpLinked: (limit: nat) -> (text);
   /// Owner enables auto top-up with explicit caps (requires ICP ICRC-2 allowance when triggered).
   setAutoTopUp: (enabled: bool, maxIcpE8sPerTopUp: nat, maxTopUpsPerDay:
    nat) -> (OpResult);
   /// Set preferred/primary site (must own it). Used by post-login picker.
   setPreferredSite: (site: principal) -> (OpResult);
   /// Set custom domain + public URL (charges 1 ICP if this hostname not yet paid).
   setSiteDomainConnection: (domain: text, publicUrl: text) -> (OpResult);
   setUserSiteWasm: (wasm: blob) -> (text);
   /// Legacy factory-mediated top-up (ICRC-2). Prefer NNS "Add cycles" on the site canister itself —
   /// UI uses NNS-only top-up so users pay from their NNS wallet without ICE II approve.
   /// `amount` = cycles to deposit. Factory must hold enough cycles.
   topUpCycles: (canisterId: principal, amount: nat) -> (OpResult);
   /// Strip non-deterministic headers for consensus on HTTP outcall responses.
   transformHttpResponse: (args: TransformArgs) ->
    (HttpResponsePayload) query;
   /// Trigger auto top-up for caller's site if enabled, low, and factory has reserve.
   /// Charges owner's ICP (ICRC-2) — never drains factory.
   tryAutoTopUpMySite: () -> (OpResult);
   /// Ops/public nudge: attempt auto top-up for a linked site if owner enabled it.
   tryAutoTopUpSite: (site: principal) -> (OpResult);
   /// Upgrade caller's site to latest stored user_site WASM (factory must be controller).
   upgradeMySite: () -> (OpResult);
 };
type DomainRecord = 
 record {
   connectedAt: int;
   dnsConfigured: bool;
   domain: text;
   publicUrl: text;
 };
type CycleAlert = 
 record {
   at: int;
   balance: nat;
   kind: text;
   message: text;
   owner: principal;
   site: principal;
 };
type CreateUserSiteResult = 
 variant {
   err: text;
   ok: principal;
 };
type AutoTopUpPref = 
 record {
   dayBucket: int;
   enabled: bool;
   lastTopUpAt: int;
   maxIcpE8sPerTopUp: nat;
   maxTopUpsPerDay: nat;
   topUpsToday: nat;
 };
/// Master Factory — provision user_site canisters, detach/relink, cycles top-up.
/// https://github.com/frostedblocks/ice-network
service : () -> Factory
