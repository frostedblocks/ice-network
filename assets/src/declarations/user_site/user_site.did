type ChunkedBeginResult = variant {
  ok : record { maxPhotoBytes : nat; maxChunkBytes : nat; uploadId : nat };
  err : text;
};
type ChunkedStatus = record {
  missingIndices : vec nat;
  contentType : text;
  receivedBytes : nat;
  receivedChunks : nat;
  totalSize : nat;
  uploadId : nat;
  chunkCount : nat;
};
type CyclesGauge = record {
  warning : opt text;
  balance : nat;
  estimatedDaysLeft : nat;
  lastCheck : int;
  lowCycles : bool;
};
type DomainStatus = record {
  customDomain : text;
  publicUrl : text;
  dnsConfigured : bool;
  domainConnectedAt : int;
  canisterId : principal;
  readyForDetach : bool;
};
type HeaderField = record { text; text };
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec HeaderField;
  certificate_version : opt nat16;
};
type HttpResponse = record {
  body : blob;
  headers : vec HeaderField;
  upgrade : opt bool;
  streaming_strategy : opt StreamingStrategy;
  status_code : nat16;
};
type Page = record { id : text; title : text; body : text; updatedAt : Time };
type PhotoMeta = record {
  id : nat;
  url : text;
  contentType : text;
  path : text;
  size : nat;
  uploadedAt : int;
};
type PhotoQuota = record {
  maxPhotos : nat;
  used : nat;
  remaining : nat;
  maxBytesPerPhoto : nat;
};
type Post = record {
  id : nat;
  content : text;
  imageURL : opt text;
  timestamp : Time;
};
type Product = record {
  id : nat;
  title : text;
  active : bool;
  createdAt : int;
  description : text;
  updatedAt : int;
  imageURL : opt text;
  photoIds : vec nat;
  currency : text;
  priceCents : nat;
    shippingCents : nat;
};
type ProductResult = variant { ok : Product; err : text };
type Receipt = record {
  id : nat;
  productId : nat;
  amountCents : nat;
  recordedAt : int;
  currency : text;
  recorder : principal;
  buyerRef : text;
};
type ReceiptResult = variant { ok : Receipt; err : text };
type SiteFormat = variant { social; store };
type SiteProfile = record { bio : text; username : text; avatarURL : text };
type SiteStatus = record {
  owner : principal;
  linkedToNetwork : bool;
  factoryId : opt principal;
  cycles : CyclesGauge;
  pageCount : nat;
  profile : SiteProfile;
};
type StreamingCallbackHttpResponse = record {
  token : opt StreamingToken;
  body : blob;
};
type StreamingStrategy = variant {
  Callback : record {
    token : StreamingToken;
    callback : func (StreamingToken) -> (StreamingCallbackHttpResponse) query;
  };
};
type StreamingToken = record {
  key : text;
  index : nat;
  content_encoding : text;
};
type StripePublicConfig = record { accountId : text; publishableKey : text };
type Time = int;
type UploadPhotoResult = variant { ok : PhotoMeta; err : text };
type UserSite = service {
  abortChunkedUpload : () -> (text);
  acceptOwnership : () -> (text);
  addTrustedRecorder : (principal) -> (text);
  beginChunkedUpload : (text, nat, nat) -> (ChunkedBeginResult);
  bindStripePublic : (text, text) -> (text);
  bootstrap : (principal, principal, text, text, text) -> (text);
  clearDomainConnection : () -> (text);
  clearStripePublic : () -> (text);
  confirmDnsConfigured : () -> (text);
  createProduct : (text, text, nat, nat, text, opt text, vec nat) -> (ProductResult);
  deletePage : (text) -> (text);
  deletePhoto : (nat) -> (text);
  deleteProduct : (nat) -> (text);
  finalizeChunkedUpload : (nat) -> (UploadPhotoResult);
  followPeer : (principal) -> (text);
  getBannerURL : () -> (text) query;
  getCanisterId : () -> (principal) query;
  getChunkedUploadStatus : () -> (opt ChunkedStatus) query;
  getCyclesGauge : () -> (CyclesGauge) query;
  getDomainStatus : () -> (DomainStatus) query;
  getFeature : (text) -> (opt bool) query;
  getFollowing : () -> (vec principal) query;
  getFormat : () -> (SiteFormat) query;
  getLocalFeed : (nat) -> (vec Post) query;
  getOwner : () -> (principal) query;
  getPage : (text) -> (opt Page) query;
  getPhotoMeta : (nat) -> (opt PhotoMeta) query;
  getPhotoQuota : () -> (PhotoQuota) query;
  getProduct : (nat) -> (opt Product) query;
  getProfile : () -> (SiteProfile) query;
  getReceipt : (nat) -> (opt Receipt) query;
  getSetting : (text) -> (opt text) query;
  getSiteStatus : () -> (SiteStatus) query;
  getStripePublic : () -> (opt StripePublicConfig) query;
  http_request : (HttpRequest) -> (HttpResponse) query;
  init : (principal) -> ();
  isLinkedToNetwork : () -> (bool) query;
  isLowCycles : () -> (bool) query;
  isReadyToDetach : () -> (bool) query;
  listAllProducts : () -> (vec Product) query;
  listFeatures : () -> (vec record { text; bool }) query;
  listPages : () -> (vec Page) query;
  listPhotos : () -> (vec PhotoMeta) query;
  listProducts : () -> (vec Product) query;
  listReceipts : () -> (vec Receipt) query;
  listSettings : () -> (vec record { text; text }) query;
  listTrustedRecorders : () -> (vec principal) query;
  makeLocalPost : (text, opt text) -> (opt nat);
  onDetach : () -> (text);
  onRelink : (principal) -> (text);
  recordCyclesSnapshot : () -> ();
  recordReceipt : (nat, text, nat, text) -> (ReceiptResult);
  removeTrustedRecorder : (principal) -> (text);
  seedTrustedRecorder : (principal) -> (text);
  setDomainConnection : (text, text) -> (text);
  setFeature : (text, bool) -> (text);
  setFormat : (SiteFormat) -> (text);
  setProfile : (text, text, text) -> (text);
  setSetting : (text, text) -> (text);
  setStripePublic : (text, text) -> (text);
  syncFromPeer : (principal, nat) -> (vec Post);
  syncOwner : (principal) -> (text);
  unfollowPeer : (principal) -> (text);
  updateProduct : (nat, text, text, nat, nat, text, opt text, vec nat, bool) -> (text);
  uploadPhoto : (text, blob) -> (UploadPhotoResult);
  uploadPhotoChunk : (nat, nat, blob) -> (text);
  upsertPage : (text, text, text) -> (text);
  usePhotoAsAvatar : (nat) -> (text);
  usePhotoAsBanner : (nat) -> (text);
};
service : UserSite